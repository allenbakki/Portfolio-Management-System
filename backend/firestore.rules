rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    function authed() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    // users: each user can manage their own doc
    match /users/{userId} {
      allow read: if authed() && userId == uid();
      allow create: if authed() && userId == uid();
      allow update, delete: if authed() && userId == uid();
    }

    // portfolios: public can read published; owner can write
    match /portfolios/{portfolioId} {
      allow read: if resource.data.published == true
                  || (authed() && resource.data.ownerId == uid());
      allow create: if authed() && request.resource.data.ownerId == uid();
      allow update, delete: if authed() && resource.data.ownerId == uid();
    }
  }
}
